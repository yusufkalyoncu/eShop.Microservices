{
  "id": "eShopRealm",
  "realm": "eShopRealm",
  "enabled": true,
  "clients": [
    {
      "clientId": "eshop-gateway-client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "eshop-gateway-client",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "identity-api-client",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "identity-api-secret"
    }
  ],
  "users": [
    {
      "username": "service-account-identity-api-client",
      "enabled": true,
      "serviceAccountClientId": "identity-api-client",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}